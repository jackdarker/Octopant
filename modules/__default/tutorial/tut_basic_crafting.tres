script = ExtResource("1_n04y5")
ID = "basic_crafting"
title = "Crafting"
text = "In your shack (and some other locations) you can craft items with collected ingredients.[br] Crafted items will go into your inventory. [br] Crafting recipes can be unlocked by talking to NPC and exploring the world.  [br] Click on a list-item to check if you have the required components, then click the craft-button. "
metadata/_custom_type_script = "uid://dlwkvnowhdyt3"
